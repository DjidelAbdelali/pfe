<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delta_robot">

  <!-- Robot Geometry Parameters (in meters) -->
  <xacro:property name="Rf" value="0.0805"/> <!-- Base Radius -->
  <xacro:property name="L"  value="0.0801"/> <!-- Bicep Length -->
  <xacro:property name="l"  value="0.1600"/> <!-- Forearm Length -->
  <xacro:property name="Re" value="0.0351"/> <!-- Nacelle Radius -->

  <!-- Materials -->
  <material name="dark_slate">
    <color rgba="0.12 0.16 0.23 1.0"/>
  </material>
  <material name="metallic_orange">
    <color rgba="1.0 0.34 0.13 1.0"/>
  </material>
  <material name="ghost_cyan">
    <color rgba="0.0 0.95 1.0 0.35"/>
  </material>
  <material name="brass_gold">
    <color rgba="0.83 0.68 0.21 1.0"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${Rf * 1.3}" length="0.012"/>
      </geometry>
      <material name="dark_slate"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${Rf * 1.3}" length="0.012"/>
      </geometry>
    </collision>
  </link>

  <!-- Macro for Arm Linkage Assembly (i = 1, 2, 3) -->
  <xacro:macro name="delta_arm" params="prefix index phi_deg">
    <xacro:property name="phi" value="${phi_deg * 3.14159265 / 180.0}"/>

    <!-- Motor Mount Pivot -->
    <joint name="${prefix}motor_joint_${index}" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}bicep_link_${index}"/>
      <origin xyz="${Rf * cos(phi)} ${Rf * sin(phi)} 0" rpy="0 0 ${phi}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
    </joint>

    <!-- Bicep Link -->
    <link name="${prefix}bicep_link_${index}">
      <visual>
        <origin xyz="${L / 2.0} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${L} 0.014 0.014"/>
        </geometry>
        <material name="metallic_orange"/>
      </visual>
    </link>

    <!-- Forearm Rod Pair -->
    <joint name="${prefix}elbow_joint_${index}" type="floating">
      <parent link="${prefix}bicep_link_${index}"/>
      <child link="${prefix}forearm_link_${index}"/>
      <origin xyz="${L} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}forearm_link_${index}">
      <visual>
        <origin xyz="${l / 2.0} 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.003" length="${l}"/>
        </geometry>
        <material name="dark_slate"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- Instantiate 3 Arms at 95.7 deg, 216.3 deg, 336.4 deg -->
  <xacro:delta_arm prefix="" index="1" phi_deg="95.7"/>
  <xacro:delta_arm prefix="" index="2" phi_deg="216.3"/>
  <xacro:delta_arm prefix="" index="3" phi_deg="336.4"/>

  <!-- Nacelle End-Effector Platform -->
  <link name="nacelle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${Re * 1.3}" length="0.008"/>
      </geometry>
      <material name="metallic_orange"/>
    </visual>
  </link>

  <joint name="nacelle_joint" type="floating">
    <parent link="base_link"/>
    <child link="nacelle_link"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
  </joint>

</robot>
